$ Invented A-B-C-D system for ESPEI's parameter gradient tests (tests/gradient_data/generate.py)
$ The VV symbols are the true parameter values of the generated datasets
ELEMENT VA VACUUM 0 0 0 !
ELEMENT A FCC_A1 10.0 0 0 !
ELEMENT B FCC_A1 20.0 0 0 !
ELEMENT C FCC_A1 30.0 0 0 !
ELEMENT D FCC_A1 40.0 0 0 !

FUNCTION VV0000 1 -8000; 10000 N !
FUNCTION VV0001 1 2.0; 10000 N !
FUNCTION VV0002 1 1500; 10000 N !
FUNCTION VV0003 1 -5000; 10000 N !
FUNCTION VV0004 1 800; 10000 N !
FUNCTION VV0005 1 2000; 10000 N !
FUNCTION VV0006 1 -500; 10000 N !
FUNCTION VV0007 1 -6000; 10000 N !
FUNCTION VV0008 1 -0.2; 10000 N !
FUNCTION VV0009 1 1000; 10000 N !
FUNCTION VV0010 1 -3000; 10000 N !
FUNCTION VV0011 1 400; 10000 N !
FUNCTION VV0012 1 -2000; 10000 N !
FUNCTION VV0013 1 600; 10000 N !
FUNCTION VV0014 1 -10000; 10000 N !
FUNCTION VV0015 1 5000; 10000 N !
FUNCTION VV0016 1 12000; 10000 N !
FUNCTION VV0017 1 -2.0; 10000 N !
FUNCTION VV0018 1 -5000; 10000 N !
FUNCTION VV0019 1 3000; 10000 N !
FUNCTION VV0020 1 -2000; 10000 N !
FUNCTION VV0021 1 6000; 10000 N !
FUNCTION VV0022 1 -20000; 10000 N !
FUNCTION VV0023 1 4.0; 10000 N !
FUNCTION VV0024 1 -16000; 10000 N !
FUNCTION VV0025 1 4000; 10000 N !
FUNCTION VV0026 1 -3000; 10000 N !
FUNCTION VV0027 1 0.5; 10000 N !
FUNCTION VV0028 1 -12000; 10000 N !
FUNCTION VV0029 1 -10000; 10000 N !
FUNCTION VV0030 1 -18000; 10000 N !
FUNCTION VV0031 1 2.0; 10000 N !

FUNCTION GFCCA 1 -25*T*LN(T); 10000 N !
FUNCTION GFCCB 1 -25*T*LN(T); 10000 N !
FUNCTION GFCCC 1 -25*T*LN(T); 10000 N !
FUNCTION GFCCD 1 -25*T*LN(T); 10000 N !
FUNCTION GLIQA 1 GFCCA#+12000-10*T; 10000 N !
FUNCTION GLIQB 1 GFCCB#+13000-10*T; 10000 N !
FUNCTION GLIQC 1 GFCCC#+14000-10*T; 10000 N !
FUNCTION GLIQD 1 GFCCD#+11000-10*T; 10000 N !
FUNCTION GORDA 1 GFCCA#+3000; 10000 N !
FUNCTION GORDB 1 GFCCB#+1000; 10000 N !
FUNCTION GORDC 1 GFCCC#+1000; 10000 N !
FUNCTION GORDD 1 GFCCD#+2000; 10000 N !

TYPE_DEFINITION % SEQ * !

PHASE LIQUID % 1 1 !
CONSTITUENT LIQUID : A,B,C,D : !
PARAMETER G(LIQUID,A;0) 1 GLIQA#; 10000 N !
PARAMETER G(LIQUID,B;0) 1 GLIQB#; 10000 N !
PARAMETER G(LIQUID,C;0) 1 GLIQC#; 10000 N !
PARAMETER G(LIQUID,D;0) 1 GLIQD#; 10000 N !
PARAMETER L(LIQUID,A,B;0) 1 VV0000#+VV0001#*T; 10000 N !
PARAMETER L(LIQUID,A,B;1) 1 VV0002#; 10000 N !
PARAMETER L(LIQUID,A,C;0) 1 VV0003#; 10000 N !
PARAMETER L(LIQUID,A,C;1) 1 VV0004#; 10000 N !
PARAMETER L(LIQUID,A,D;0) 1 VV0005#; 10000 N !
PARAMETER L(LIQUID,A,D;1) 1 VV0006#; 10000 N !
PARAMETER L(LIQUID,B,C;0) 1 VV0007#+VV0008#*T*LN(T); 10000 N !
PARAMETER L(LIQUID,B,C;1) 1 VV0009#; 10000 N !
PARAMETER L(LIQUID,B,D;0) 1 VV0010#; 10000 N !
PARAMETER L(LIQUID,B,D;1) 1 VV0011#; 10000 N !
PARAMETER L(LIQUID,C,D;0) 1 VV0012#; 10000 N !
PARAMETER L(LIQUID,C,D;1) 1 VV0013#; 10000 N !
PARAMETER L(LIQUID,A,B,C;0) 1 VV0014#; 10000 N !

PHASE FCC_A1 % 2 1 1 !
CONSTITUENT FCC_A1 : A,B,C,D : VA : !
PARAMETER G(FCC_A1,A:VA;0) 1 GFCCA#; 10000 N !
PARAMETER G(FCC_A1,B:VA;0) 1 GFCCB#; 10000 N !
PARAMETER G(FCC_A1,C:VA;0) 1 GFCCC#; 10000 N !
PARAMETER G(FCC_A1,D:VA;0) 1 GFCCD#; 10000 N !
PARAMETER L(FCC_A1,A,B:VA;0) 1 VV0015#; 10000 N !
PARAMETER L(FCC_A1,A,C:VA;0) 1 VV0016#+VV0017#*T; 10000 N !
PARAMETER L(FCC_A1,B,C:VA;0) 1 VV0018#; 10000 N !
PARAMETER L(FCC_A1,A,D:VA;0) 1 VV0019#; 10000 N !
PARAMETER L(FCC_A1,B,D:VA;0) 1 VV0020#; 10000 N !
PARAMETER L(FCC_A1,C,D:VA;0) 1 VV0021#; 10000 N !

PHASE TAU % 2 1 1 !
CONSTITUENT TAU : A,B : C,D,VA : !
PARAMETER G(TAU,A:C;0) 1 GFCCA#+GFCCC#+VV0022#+VV0023#*T+VV0027#*T*LN(T); 10000 N !
PARAMETER G(TAU,B:D;0) 1 GFCCB#+GFCCD#+VV0024#; 10000 N !
PARAMETER G(TAU,B:C;0) 1 GFCCB#+GFCCC#+-4000; 10000 N !
PARAMETER G(TAU,A:D;0) 1 GFCCA#+GFCCD#+-4000; 10000 N !
PARAMETER G(TAU,A:VA;0) 1 GFCCA#+8000; 10000 N !
PARAMETER G(TAU,B:VA;0) 1 GFCCB#+8000; 10000 N !
PARAMETER L(TAU,A,B:*;0) 1 VV0025#; 10000 N !
PARAMETER L(TAU,*:C,VA;0) 1 VV0026#; 10000 N !

$ Two equivalent sublattices with additive endmembers and no ordering energy: the minimum is disordered
PHASE ORD % 2 1 1 !
CONSTITUENT ORD : A,B,C,D : A,B,C,D : !
PARAMETER G(ORD,A:A;0) 1 GORDA#+GORDA#; 10000 N !
PARAMETER G(ORD,A:B;0) 1 GORDA#+GORDB#; 10000 N !
PARAMETER G(ORD,A:C;0) 1 GORDA#+GORDC#; 10000 N !
PARAMETER G(ORD,A:D;0) 1 GORDA#+GORDD#; 10000 N !
PARAMETER G(ORD,B:A;0) 1 GORDB#+GORDA#; 10000 N !
PARAMETER G(ORD,B:B;0) 1 GORDB#+GORDB#; 10000 N !
PARAMETER G(ORD,B:C;0) 1 GORDB#+GORDC#; 10000 N !
PARAMETER G(ORD,B:D;0) 1 GORDB#+GORDD#; 10000 N !
PARAMETER G(ORD,C:A;0) 1 GORDC#+GORDA#; 10000 N !
PARAMETER G(ORD,C:B;0) 1 GORDC#+GORDB#; 10000 N !
PARAMETER G(ORD,C:C;0) 1 GORDC#+GORDC#; 10000 N !
PARAMETER G(ORD,C:D;0) 1 GORDC#+GORDD#; 10000 N !
PARAMETER G(ORD,D:A;0) 1 GORDD#+GORDA#; 10000 N !
PARAMETER G(ORD,D:B;0) 1 GORDD#+GORDB#; 10000 N !
PARAMETER G(ORD,D:C;0) 1 GORDD#+GORDC#; 10000 N !
PARAMETER G(ORD,D:D;0) 1 GORDD#+GORDD#; 10000 N !
PARAMETER L(ORD,B,C:*;0) 1 VV0028#; 10000 N !
PARAMETER L(ORD,*:B,C;0) 1 VV0028#; 10000 N !
PARAMETER L(ORD,C,D:*;0) 1 VV0029#; 10000 N !
PARAMETER L(ORD,*:C,D;0) 1 VV0029#; 10000 N !

PHASE AB2 % 2 1 2 !
CONSTITUENT AB2 : A : B : !
PARAMETER G(AB2,A:B;0) 1 GFCCA#+2*GFCCB#+VV0030#+VV0031#*T; 10000 N !
